<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- RELEASE ONLY, AND DELIBERATELY SO. Do not "fix" this by adding a Debug
       configuration without reading the LinkIncremental note below.

       Two reasons. The add-in exists to look like the third-party XLLs a user
       actually has, and those ship Release; a Debug subject is a rarer
       population. More importantly, Debug DEFAULTS LinkIncremental to true,
       and incremental linking routes every export through an E9 thunk - so a
       Debug configuration added the obvious way would silently erase the
       direct-prologue case from the suite, and every test would still pass.
       Any Debug configuration added here must set LinkIncremental false too.

       XRayXL.sln maps this project's Debug slot onto Release, so building the
       solution as Debug still produces a Release subject (into
       build\x64\Release\TracedAddin\, which is where the suites look for it).

       AND NO VERSION RESOURCE, for the same kind of reason. Nothing reads one:
       the tracer's only version-resource read is LoadedVbe7, hardcoded to
       VBE7.DLL, and a trace row carries a module's NAME, never its version.
       What would be left is an invented version number in a field readers
       trust, which is the confident wrong answer this project keeps refusing.
       The two things a resource could say are already settled elsewhere:
       WHICH FILE is settled by the SHA256 the test manager records for every
       registered add-in, and WHICH CONFIGURATION by there being only one. -->
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>17.0</VCProjectVersion>
    <ProjectGuid>{4D1C9E00-0001-4A00-9000-00000000B001}</ProjectGuid>
    <RootNamespace>TracedAddin</RootNamespace>
    <Keyword>Win32Proj</Keyword>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>v145</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="ExtensionSettings">
    <Import Project="$(VCTargetsPath)\BuildCustomizations\masm.props" />
  </ImportGroup>
  <PropertyGroup>
    <!-- Three levels up from tests\fixtures\TracedAddin is the repo root; see the note in
         XRayXL.vcxproj about why this is not $(SolutionDir). -->
    <XRayRoot>$(MSBuildProjectDirectory)\..\..\..\</XRayRoot>
    <OutDir>$(XRayRoot)build\$(Platform)\$(Configuration)\TracedAddin\</OutDir>
    <IntDir>$(XRayRoot)build\obj\$(Platform)\$(Configuration)\TracedAddin\</IntDir>
    <!-- The bitness is in the name, as for XRayXL. -->
    <AddinBits Condition="'$(Platform)'=='Win32'">32</AddinBits>
    <AddinBits Condition="'$(Platform)'!='Win32'">64</AddinBits>
    <TargetName>TracedAddin$(AddinBits)</TargetName>
    <TargetExt>.xll</TargetExt>
    <!-- Incremental linking routes EVERY export through an E9 rel32 thunk, so
         with it on, every function presents the tracer with the same shape and
         the direct prologue case is never tested at all. A normally built
         release XLL has it off and its exports point straight at code, which is
         the commoner shape in the wild. Off here so the suite covers that;
         jumptable.asm still supplies genuinely indirect exports, so both
         shapes are exercised.
         (LinkIncremental is a PROPERTY, not Link metadata.) -->
    <LinkIncremental>false</LinkIncremental>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <ExceptionHandling>Sync</ExceptionHandling>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>true</TreatWarningAsError>
      <SDLCheck>false</SDLCheck>
      <ConformanceMode>true</ConformanceMode>
      <Optimization>MaxSpeed</Optimization>
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
      <PreprocessorDefinitions>UNICODE;_UNICODE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(XRayRoot)src\third_party;$(XRayRoot)tests\fixtures\xll_common;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <ModuleDefinitionFile>tracedaddin.def</ModuleDefinitionFile>
      <!-- Linker by-products go to IntDir, leaving OutDir with just the .xll. -->
      <ImportLibrary>$(IntDir)$(TargetName).lib</ImportLibrary>
      <ProgramDatabaseFile>$(IntDir)$(TargetName).pdb</ProgramDatabaseFile>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <!-- The PDB is named without this machine's build path. -->
      <AdditionalOptions>/PDBALTPATH:%25_PDB%25 %(AdditionalOptions)</AdditionalOptions>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="tracedaddin.cpp" />
  </ItemGroup>
  <ItemGroup>
    <MASM Include="jumptable.asm" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="..\xll_common\plain_xll.h" />
  </ItemGroup>
  <ItemGroup>
    <None Include="tracedaddin.def" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets">
    <Import Project="$(VCTargetsPath)\BuildCustomizations\masm.targets" />
  </ImportGroup>
</Project>
