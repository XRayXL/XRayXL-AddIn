<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <XRayVersionMajor>0</XRayVersionMajor>
    <XRayVersionMinor>3</XRayVersionMinor>
    <XRayVersionPatch>0</XRayVersionPatch>
  </PropertyGroup>

  <!-- The build configuration goes into VERSIONINFO, since build\addin\ names none and Debug and
       Release share a version. A number: a quoted-string define does not survive rc.exe. -->
  <PropertyGroup>
    <XRayBuildConfig>$(Configuration)</XRayBuildConfig>
    <XRayBuildDebugFlag Condition="'$(XRayBuildConfig)'=='Debug'">1</XRayBuildDebugFlag>
    <XRayBuildDebugFlag Condition="'$(XRayBuildConfig)'=='Release'">0</XRayBuildDebugFlag>
    <XRayBuildDebugFlag Condition="'$(XRayBuildDebugFlag)'==''">2</XRayBuildDebugFlag>
  </PropertyGroup>
</Project>
