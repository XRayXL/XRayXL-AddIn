<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <XRayVersionMajor>0</XRayVersionMajor>
    <XRayVersionMinor>2</XRayVersionMinor>
    <XRayVersionPatch>0</XRayVersionPatch>
  </PropertyGroup>

  <!-- The configuration the binary was built as, carried into its VERSIONINFO: the suites load
       from build\addin\, which names no configuration, and Debug and Release share a version.
       A number, because a quoted-string define does not survive rc.exe's command line.
       Anything but Debug or Release yields 2, which the resource reads as UNKNOWN. -->
  <PropertyGroup>
    <XRayBuildConfig>$(Configuration)</XRayBuildConfig>
    <XRayBuildDebugFlag Condition="'$(XRayBuildConfig)'=='Debug'">1</XRayBuildDebugFlag>
    <XRayBuildDebugFlag Condition="'$(XRayBuildConfig)'=='Release'">0</XRayBuildDebugFlag>
    <XRayBuildDebugFlag Condition="'$(XRayBuildDebugFlag)'==''">2</XRayBuildDebugFlag>
  </PropertyGroup>
</Project>
