; The module's only export list. A .def exports plain names on x86 as well as x64, where __stdcall
; would decorate them and Excel would find nothing. A function missing here is not exported, and
; commands.cpp logs its registration as FAILED.

EXPORTS
    xlAutoOpen
    xlAutoClose
    xlAutoRemove
    xlAutoFree12
    xlAddInManagerInfo12

; Office serves ribbon controls only to a COM add-in, so this DLL is an in-proc server for one CLSID
; (src/ui/ribbon.cpp). PRIVATE keeps these out of the import library, which is what LNK4104 asks
; for.
    DllGetClassObject PRIVATE
    DllCanUnloadNow PRIVATE

; Arm and disarm as XLL commands, callable as Application.Run("XRayXL_Arm") with no window, no focus
; and no COM object of ours. The ribbon presses these; it does not replace them.
    XRayXL_Arm
    XRayXL_Disarm
    XRayXL_SetTraceParam
    XRayXL_GetTraceParam
    XRayXL_GetTraceSummary
    XRayXL_IsArmed
    XRayXL_FaultProbe

; What gets traced. Functions rather than commands, because each takes arguments and returns an
; answer:
;    Application.Run("XRayXL_SetTraceParam", "XLL", "DEPTH", "ALL")
;    Application.Run("XRayXL_GetTraceParam", "VBA", "DEPTH")
;    Application.Run("XRayXL_GetTraceSummary")
