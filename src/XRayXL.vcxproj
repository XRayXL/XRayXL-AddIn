  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>17.0</VCProjectVersion>
    <ProjectGuid>{4D1C9E00-0001-4A00-9000-00000000A001}</ProjectGuid>
    <RootNamespace>XRayXL</RootNamespace>
    <Keyword>Win32Proj</Keyword>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <!-- The product version and build configuration, for the VERSIONINFO resource and the log.
       Imported after Microsoft.Cpp.Default.props, which establishes $(Configuration) when this
       project is built on its own. -->
  <Import Project="$(MSBuildProjectDirectory)\..\version.props" />
  <PropertyGroup Condition="'$(Configuration)'=='Debug'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <UseDebugLibraries>true</UseDebugLibraries>
    <PlatformToolset>v145</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>v145</PlatformToolset>
    <WholeProgramOptimization>true</WholeProgramOptimization>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="ExtensionSettings">
    <Import Project="$(VCTargetsPath)\BuildCustomizations\masm.props" />
  </ImportGroup>
  <PropertyGroup>
    <!-- Build output goes to the repo's build folder. Not $(SolutionDir), which is the project
         directory when the .vcxproj is built on its own, where tools\deploy.ps1 does not look. -->
    <XRayRoot>$(MSBuildProjectDirectory)\..\</XRayRoot>
    <OutDir>$(XRayRoot)build\$(Platform)\$(Configuration)\XRayXL\</OutDir>
    <IntDir>$(XRayRoot)build\obj\$(Platform)\$(Configuration)\XRayXL\</IntDir>
    <!-- Stable across versions, so Excel's stored add-in path survives a
         version bump; the bitness is in the name so 32- and 64-bit copies can
         sit side by side. -->
    <XRayBits Condition="'$(Platform)'=='Win32'">32</XRayBits>
    <XRayBits Condition="'$(Platform)'!='Win32'">64</XRayBits>
    <TargetName>XRayXL$(XRayBits)</TargetName>
    <TargetExt>.xll</TargetExt>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <ExceptionHandling>Sync</ExceptionHandling>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>true</TreatWarningAsError>
      <SDLCheck>true</SDLCheck>
      <ConformanceMode>true</ConformanceMode>
      <!-- No /guard:cf: calls through MinHook's generated trampolines would fail its checks. -->
      <!-- The version arrives as three NUMERIC defines, never a quoted
           string: a string-valued define does not survive to rc.exe and fails
           silently there. The text form is composed by stringize at the point
           of use (XRayXL.rc, dllmain.cpp). -->
      <PreprocessorDefinitions>UNICODE;_UNICODE;XRAY_VER_MAJOR=$(XRayVersionMajor);XRAY_VER_MINOR=$(XRayVersionMinor);XRAY_VER_PATCH=$(XRayVersionPatch);XRAY_BUILD_DEBUG=$(XRayBuildDebugFlag);%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(ProjectDir);$(ProjectDir)third_party;$(ProjectDir)third_party\minhook\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
    </ClCompile>
    <ResourceCompile>
      <PreprocessorDefinitions>XRAY_BITS=$(XRayBits);XRAY_VER_MAJOR=$(XRayVersionMajor);XRAY_VER_MINOR=$(XRayVersionMinor);XRAY_VER_PATCH=$(XRayVersionPatch);XRAY_BUILD_DEBUG=$(XRayBuildDebugFlag);%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ResourceCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <ModuleDefinitionFile>XRayXL.def</ModuleDefinitionFile>
      <!-- Linker by-products go to IntDir, leaving OutDir with just the .xll. -->
      <ImportLibrary>$(IntDir)$(TargetName).lib</ImportLibrary>
      <ProgramDatabaseFile>$(IntDir)$(TargetName).pdb</ProgramDatabaseFile>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <!-- The PDB is named without this machine's build path. -->
      <AdditionalOptions>/PDBALTPATH:%25_PDB%25 %(AdditionalOptions)</AdditionalOptions>
      <AdditionalDependencies>version.lib;oleacc.lib;oleaut32.lib;ole32.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <Optimization>Disabled</Optimization>
      <RuntimeLibrary>MultiThreadedDebugDLL</RuntimeLibrary>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <Optimization>MaxSpeed</Optimization>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
    </ClCompile>
    <Link>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
    </Link>
  </ItemDefinitionGroup>
