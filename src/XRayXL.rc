// The deployed file keeps a stable name, so this resource alone says which build is installed.
// The string is composed here because a quoted-string define does not survive rc.exe's command
// line: every string comes out empty, with exit code 0. The 0.0.0 fallback is meant to look broken.

#include <winver.h>

#ifndef XRAY_VER_MAJOR
#define XRAY_VER_MAJOR 0
#endif
#ifndef XRAY_VER_MINOR
#define XRAY_VER_MINOR 0
#endif
#ifndef XRAY_VER_PATCH
#define XRAY_VER_PATCH 0
#endif

#define XRAY_STR2(x) #x
#define XRAY_STR(x)  XRAY_STR2(x)
#define XRAY_VERSION_TEXT \
    XRAY_STR(XRAY_VER_MAJOR) "." XRAY_STR(XRAY_VER_MINOR) "." XRAY_STR(XRAY_VER_PATCH)

// The configuration, a number for the same reason. Not _DEBUG: build\addin\ names no configuration
// and both share a version. Anything but 0 or 1 means the define never arrived.
#ifndef XRAY_BUILD_DEBUG
#define XRAY_BUILD_DEBUG 2
#endif

#if   XRAY_BUILD_DEBUG == 0
#define XRAY_CONFIG_TEXT  "Release"
#define XRAY_CONFIG_FLAGS 0x0L
#elif XRAY_BUILD_DEBUG == 1
#define XRAY_CONFIG_TEXT  "Debug"
#define XRAY_CONFIG_FLAGS VS_FF_DEBUG
#else
#define XRAY_CONFIG_TEXT  "UNKNOWN"
#define XRAY_CONFIG_FLAGS VS_FF_DEBUG
#endif

// One file name per bitness; XRAY_BITS comes from the project.
#if defined(XRAY_BITS) && XRAY_BITS == 32
#define XRAY_FILE_NAME "XRayXL32.xll"
#else
#define XRAY_FILE_NAME "XRayXL64.xll"
#endif

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    XRAY_VER_MAJOR,XRAY_VER_MINOR,XRAY_VER_PATCH,0
 PRODUCTVERSION XRAY_VER_MAJOR,XRAY_VER_MINOR,XRAY_VER_PATCH,0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      XRAY_CONFIG_FLAGS
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_DLL
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"                 // US English, Unicode
        BEGIN
            VALUE "ProductName",      "XRayXL"
            VALUE "FileDescription",  "XRayXL, Excel calculation diagnostics"
            VALUE "CompanyName",      "Andrew Lockhart"
            VALUE "LegalCopyright",   "Copyright (c) 2026 Andrew Lockhart. GPL-3.0."
            VALUE "InternalName",     "XRayXL"
            // Excel stores the add-in's path, so no filename carries the version;
            // this field is what identifies a stray copy.
            VALUE "OriginalFilename", XRAY_FILE_NAME
            VALUE "FileVersion",      XRAY_VERSION_TEXT
            VALUE "ProductVersion",   XRAY_VERSION_TEXT
            // Separates Debug from Release by eye. Tools should read the VS_FF_DEBUG flag
            // above, which FileVersionInfo exposes as .IsDebug.
            VALUE "BuildConfig",      XRAY_CONFIG_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 0x04B0
    END
END

/////////////////////////////////////////////////////////////////////////////
// The Options dialog. Every page's controls are in this one template, shown or hidden by page;
// optionsdlg.cpp places them all in pixels, so the coordinates here are only placeholders.

#include <windows.h>
#include "ui/optionsres.h"
#include "ui/diagres.h"

// The texts on the About and Notices pages, compiled in. Both also ship beside the XLL.
IDR_LICENSE RCDATA "..\\LICENSE"
IDR_NOTICES RCDATA "..\\THIRD-PARTY-NOTICES.txt"

IDD_XRAY_OPTIONS DIALOGEX 0, 0, 400, 186
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER |
      WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_CLIPCHILDREN
CAPTION "XRayXL Options"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LISTBOX         IDC_CATEGORIES, 8, 8, 80, 146,
                    LBS_OWNERDRAWFIXED | LBS_HASSTRINGS | LBS_NOTIFY |
                    LBS_NOINTEGRALHEIGHT | NOT WS_BORDER | WS_TABSTOP
    CONTROL         "", IDC_PAGEICON, "Static", SS_OWNERDRAW, 100, 9, 16, 16
    LTEXT           "", IDC_ARMEDNOTE, 100, 148, 290, 18, SS_LEFT

    // ---- Capture -------------------------------------------------------
    LTEXT           "What XRayXL records.", IDC_CAP_HDR, 122, 13, 268, 11
    LTEXT           "XLL add-in functions", IDC_XLL_SEC1, 100, 36, 290, 9
    CONTROL         "", IDC_XLL_RULE1, "Static", SS_OWNERDRAW, 100, 40, 290, 1
    LTEXT           "Depth:", IDC_XLL_DEPTHLBL, 107, 56, 82, 9
    COMBOBOX        IDC_XLL_DEPTH, 196, 54, 110, 60, CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    CONTROL         "Capture &argument values", IDC_XLL_ARGS, "Button", BS_OWNERDRAW | WS_TABSTOP, 198, 78, 192, 10
    CONTROL         "Capture &return values", IDC_XLL_RET, "Button", BS_OWNERDRAW | WS_TABSTOP, 198, 94, 192, 10
    LTEXT           "VBA procedures", IDC_VBA_SEC1, 100, 110, 290, 9
    CONTROL         "", IDC_VBA_RULE1, "Static", SS_OWNERDRAW, 100, 114, 290, 1
    LTEXT           "Depth:", IDC_VBA_DEPTHLBL, 107, 126, 82, 9
    COMBOBOX        IDC_VBA_DEPTH, 196, 124, 110, 60, CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    CONTROL         "Capture ar&gument values", IDC_VBA_ARGS, "Button", BS_OWNERDRAW | WS_TABSTOP, 198, 140, 192, 10
    CONTROL         "Capture re&turn values", IDC_VBA_RET, "Button", BS_OWNERDRAW | WS_TABSTOP, 198, 152, 192, 10
    CONTROL         "Describe &objects (Range, Worksheet, Workbook)", IDC_VBA_OBJ, "Button", BS_OWNERDRAW | WS_TABSTOP, 198, 164, 192, 10

    // ---- Events --------------------------------------------------------
    LTEXT           "Which of Excel's own events XRayXL records.", IDC_EVT_HDR, 122, 13, 268, 11
    LTEXT           "Application events", IDC_EVT_SEC1, 100, 36, 290, 9
    CONTROL         "", IDC_EVT_RULE1, "Static", SS_OWNERDRAW, 100, 40, 290, 1
    LTEXT           "Record:", IDC_EVT_PRESETLBL, 107, 56, 82, 9
    COMBOBOX        IDC_EVT_PRESET, 196, 54, 110, 60, CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_EVT_COUNT, 312, 56, 78, 9

    // ---- Output --------------------------------------------------------
    LTEXT           "Where the trace goes, and in what format.", IDC_OUT_HDR, 122, 13, 268, 11
    LTEXT           "Trace output", IDC_OUT_SEC1, 100, 36, 290, 9
    CONTROL         "", IDC_OUT_RULE1, "Static", SS_OWNERDRAW, 100, 40, 290, 1
    LTEXT           "Format:", IDC_OUT_FMTLBL, 107, 56, 82, 9
    COMBOBOX        IDC_OUT_FMT, 196, 54, 110, 60, CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Output folder:", IDC_OUT_DIRLBL, 107, 72, 82, 9
    EDITTEXT        IDC_OUT_DIR, 107, 82, 283, 13, ES_AUTOHSCROLL | ES_READONLY | NOT WS_TABSTOP | NOT WS_BORDER
    LTEXT           "Trace file:", IDC_OUT_FILELBL, 107, 98, 82, 9
    EDITTEXT        IDC_OUT_FILE, 107, 108, 283, 13, ES_AUTOHSCROLL | ES_READONLY | NOT WS_TABSTOP | NOT WS_BORDER
    CONTROL         "&Tail in PowerShell", IDC_OUT_TAIL, "Button", BS_OWNERDRAW | WS_TABSTOP, 107, 124, 96, 15

    // ---- Advanced ------------------------------------------------------
    LTEXT           "The trace file's buffer and extra column, and the add-in's own log.", IDC_ADV_HDR, 122, 13, 268, 11
    LTEXT           "Trace file", IDC_ADV_SEC1, 100, 36, 290, 9
    CONTROL         "", IDC_ADV_RULE1, "Static", SS_OWNERDRAW, 100, 40, 290, 1
    LTEXT           "Buffer size:", IDC_ADV_BUFLBL, 107, 56, 82, 9
    EDITTEXT        IDC_ADV_BUF, 196, 54, 52, 13, ES_AUTOHSCROLL | NOT WS_BORDER
    LTEXT           "64MB, 512KB, or 0 = synchronous.", IDC_ADV_BUFHINT, 196, 68, 136, 9
    LTEXT           "When full:", IDC_ADV_FULLLBL, 107, 80, 82, 9
    COMBOBOX        IDC_ADV_FULL, 196, 78, 110, 60, CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    CONTROL         "Add a &breaks column: VBA calls that stopped at a breakpoint", IDC_ADV_BRK, "Button", BS_OWNERDRAW | WS_TABSTOP, 107, 94, 283, 10
    LTEXT           "Logging", IDC_ADV_SEC2, 100, 107, 290, 9
    CONTROL         "", IDC_ADV_RULE2, "Static", SS_OWNERDRAW, 100, 111, 290, 1
    LTEXT           "Log level:", IDC_ADV_LVLLBL, 107, 123, 82, 9
    COMBOBOX        IDC_ADV_LVL, 196, 121, 110, 60, CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Takes effect at once, armed or not.", IDC_ADV_LVLNOTE, 196, 137, 194, 9
    LTEXT           "Log file:", IDC_ADV_LOGLBL, 107, 149, 82, 9
    EDITTEXT        IDC_ADV_LOG, 107, 159, 283, 13, ES_AUTOHSCROLL | ES_READONLY | NOT WS_TABSTOP | NOT WS_BORDER

    // ---- About ---------------------------------------------------------
    LTEXT           "About XRayXL", IDC_ABT_HDR, 122, 13, 268, 11
    LTEXT           "", IDC_ABT_OWNER, 107, 36, 283, 9
    LTEXT           "GNU General Public License, version 3", IDC_ABT_LICLBL, 107, 58, 283, 9
    EDITTEXT        IDC_ABT_LICENSE, 107, 68, 283, 92, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | NOT WS_BORDER

    // ---- Notices -------------------------------------------------------
    LTEXT           "Third Party Notices", IDC_NOT_HDR, 122, 13, 268, 11
    EDITTEXT        IDC_NOT_TEXT, 107, 36, 283, 124, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | NOT WS_BORDER

    CONTROL         "Apply", IDOK, "Button", BS_OWNERDRAW | BS_DEFPUSHBUTTON | WS_TABSTOP, 278, 169, 54, 15
    CONTROL         "Cancel", IDCANCEL, "Button", BS_OWNERDRAW | WS_TABSTOP, 336, 169, 54, 15
END

/////////////////////////////////////////////////////////////////////////////
// The Diagnostics dialog. As with Options, diagnosticsdlg.cpp places every control in pixels,
// so the coordinates here are only placeholders. The list has no entry: it is our own window
// class, created at WM_INITDIALOG.

IDD_XRAY_DIAG DIALOGEX 0, 0, 480, 250
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER |
      WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_CLIPCHILDREN
CAPTION "XRayXL Diagnostics"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LISTBOX         IDC_DIAG_CATEGORIES, 8, 8, 80, 200,
                    LBS_OWNERDRAWFIXED | LBS_HASSTRINGS | LBS_NOTIFY |
                    LBS_NOINTEGRALHEIGHT | NOT WS_BORDER | WS_TABSTOP
    CONTROL         "", IDC_DIAG_PAGEICON, "Static", SS_OWNERDRAW, 100, 9, 16, 16
    LTEXT           "", IDC_DIAG_HDR, 122, 13, 348, 11

    LTEXT           "&Search:", IDC_DIAG_SEARCHLBL, 100, 34, 40, 11
    EDITTEXT        IDC_DIAG_SEARCH, 140, 32, 330, 13, ES_AUTOHSCROLL | NOT WS_BORDER

END
